            "443"
          ]
        }
      ]
    },
    {
      "key": "allow-monitoring",
      "name": "Allow monitoring",
      "order": 30,
      "action": "ALLOW",
      "enabled": true,
      "logging": true,
      "sourceIpSets": [
        "monitor"
      ],
      "destinationIpSets": [
        "web"
      ],
      "services": [
        {
          "protocol": "TCP",
          "ports": [
            "443"
          ]
        }
      ]
    }
