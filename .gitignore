# Local runtime output
logs/
test-results/
reports/
*.tmp

# Developer tooling
.vs/
.vscode/
*.user
.DS_Store
Thumbs.db

# Future observed/applied state should not enter desired-state Git repo
state/**/observed/
state/**/applied/
*.lock

# Local-only configuration backup created by simulator setup
config/application.json.before-simulator

# Synthetic simulator edits (runtime only; never commit)
simulator/runtime-state.json
simulator/runtime-state.json.*

# Engineer-owned local templates (can contain rule descriptions)
templates/user-firewall-rules.json
